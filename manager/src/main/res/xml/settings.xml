<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="startup"
        android:title="@string/settings_startup">

        <rikka.material.preference.MaterialSwitchPreference
            android:key="start_on_boot"
            android:summary="@string/settings_start_on_boot_summary"
            android:title="@string/settings_start_on_boot" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="recovery_tcp_enabled"
            android:defaultValue="false"
            android:title="@string/recovery_tcp_title"
            android:summary="@string/recovery_tcp_summary" />
        <EditTextPreference
            android:key="recovery_tcp_port"
            android:defaultValue="5555"
            android:title="@string/recovery_port_title"
            android:summary="%s" />
        <rikka.material.preference.MaterialSwitchPreference
            android:key="recovery_watchdog"
            android:defaultValue="false"
            android:title="@string/recovery_watchdog_title"
            android:summary="@string/recovery_watchdog_summary" />
        <rikka.material.preference.MaterialSwitchPreference
            android:key="recovery_experiment_enabled"
            android:defaultValue="false"
            android:title="@string/recovery_experiment_title"
            android:summary="@string/recovery_experiment_summary" />
        <Preference android:key="recovery_experiment_log"
            android:title="@string/recovery_experiment_log_title"
            android:summary="@string/recovery_experiment_log_summary" />
        <Preference android:key="recovery_start" android:title="@string/recovery_start_title"
            android:summary="@string/recovery_start_summary" />
        <Preference android:key="recovery_status" android:title="@string/recovery_status_title"
            android:summary="@string/recovery_waiting" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_language">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:summary="%s"
            android:title="@string/settings_language" />

        <Preference
            style="?preferenceInformationStyle"
            android:key="translation_contributors"
            android:title="@string/settings_translation_contributors" />

        <Preference
            android:key="translation"
            android:title="@string/settings_translation" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="user_interface"
        android:title="@string/settings_user_interface">

        <moe.shizuku.manager.settings.IntegerSimpleMenuPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="black_night_theme"
            android:summary="@string/settings_black_night_theme_summary"
            android:title="@string/settings_black_night_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color" />

    </PreferenceCategory>

</PreferenceScreen>
